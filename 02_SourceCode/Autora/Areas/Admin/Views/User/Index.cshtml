@model Autora.ViewModels.UserListViewModel
@{Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";}
<h2>Tài khoản và phân quyền</h2><p>@TempData["Success"]</p><p class="text-danger">@TempData["Error"]</p><form method="get" class="d-flex gap-2 mb-3"><input name="keyword" value="@Model.Keyword" placeholder="Tìm tên hoặc email" class="form-control"/><button class="btn btn-outline-secondary">Tìm</button></form>
<details class="card p-3 mb-3"><summary>Tạo nhân viên / quản trị viên</summary><form asp-action="Create" method="post"><label>Họ tên</label><input name="FullName" maxlength="150" required class="form-control"/><label>Email</label><input name="Email" type="email" required class="form-control"/><label>Điện thoại</label><input name="Phone" maxlength="20" required class="form-control"/><label>Mật khẩu riêng</label><input name="Password" type="password" minlength="8" maxlength="100" required autocomplete="new-password" class="form-control"/><select name="Role" class="form-select"><option value="Employee">Nhân viên</option><option value="Admin">Quản trị viên</option></select><button class="btn btn-primary">Tạo tài khoản</button></form></details>
<div class="table-responsive"><table class="table"><thead><tr><th>Họ tên / Email</th><th>Trạng thái</th><th>Vai trò</th><th>Thao tác</th></tr></thead><tbody>@foreach(var u in Model.Users){<tr><td>@u.FullName<br/>@u.Email</td><td>@(u.IsActive?"Hoạt động":"Đã khóa")</td><td><form asp-action="ChangeRole" method="post"><input name="id" value="@u.Id" type="hidden"/><select name="role" class="form-select">@foreach(var role in new[]{"Customer","Employee","Admin"}){<option value="@role" selected="@(u.Role==role)">@role</option>}</select><button class="btn btn-sm btn-outline-primary">Lưu quyền</button></form></td><td><a asp-action="Reset" asp-route-id="@u.Id">Đặt mật khẩu mới</a>@if(!u.IsCurrentAdmin){<form asp-action="ToggleStatus" method="post"><input name="id" value="@u.Id" type="hidden"/><button class="btn btn-sm btn-outline-secondary">@(u.IsActive?"Khóa":"Mở khóa")</button></form><form asp-action="Delete" method="post" class="confirm-user-action" data-user-name="@u.FullName"><input name="id" value="@u.Id" type="hidden"/><button class="btn btn-sm btn-outline-danger">Xóa / vô hiệu hóa</button></form>}</td></tr>}</tbody></table></div><p>Trang @Model.Page / @Model.Pages · @Model.Total tài khoản</p>@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-keyword="@Model.Keyword">Trước</a>} @if(Model.Page<Model.Pages){<a asp-route-page="@(Model.Page+1)" asp-route-keyword="@Model.Keyword">Sau</a>}
@section Scripts{<script src="~/js/user-actions.js" asp-append-version="true"></script>}
