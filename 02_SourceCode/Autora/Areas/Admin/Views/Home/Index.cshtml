@{Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";ViewData["Title"]="Tổng quan";}
<h3>Tổng quan dữ liệu thực tế</h3><div class="row g-3"><div class="col-md-4"><div class="card p-3">Tổng số xe <strong>@ViewBag.Cars</strong></div></div><div class="col-md-4"><div class="card p-3">Xe đã cọc <strong>@ViewBag.Deposited</strong></div></div><div class="col-md-4"><div class="card p-3">Xe đã bán <strong>@ViewBag.Sold</strong></div></div></div><p class="mt-4">Doanh thu xe đã bàn giao: @(((decimal)ViewBag.Revenue).ToString("N0")) đ</p><p>Thực thu toàn bộ giao dịch: @(((decimal)ViewBag.Cash).ToString("N0")) đ</p>
