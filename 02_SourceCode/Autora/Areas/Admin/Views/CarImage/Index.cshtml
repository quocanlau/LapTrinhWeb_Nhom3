@model Car
@{Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";}
<h2>Ảnh xe · @Model.VIN</h2><p>Tối đa 12 ảnh; PNG/JPEG/WebP, mỗi file tối đa 5 MB. Không sửa ảnh xe đang có giao dịch.</p><form asp-action="Add" method="post" enctype="multipart/form-data" class="card p-3 mb-3"><input name="carId" value="@Model.Id" type="hidden"/><label>Chọn file ảnh</label><input name="file" type="file" accept="image/jpeg,image/png,image/webp" class="form-control"/><label>Hoặc đường dẫn / URL HTTPS</label><input name="imageUrl" class="form-control"/><label>Thứ tự</label><input name="sortOrder" type="number" min="0" max="1000" value="0" class="form-control"/><button class="btn btn-primary">Thêm ảnh</button></form>
<div class="row g-3">@foreach(var x in Model.Images.OrderBy(x=>x.SortOrder).ThenBy(x=>x.Id)){<div class="col-md-4"><div class="card p-3"><img src="@x.ImagePath" alt="Ảnh xe" style="height:180px;object-fit:cover"/><p>@(x.IsPrimary?"Ảnh chính":"Ảnh phụ")</p><form asp-action="Update" method="post"><input name="carId" value="@Model.Id" type="hidden"/><input name="imageId" value="@x.Id" type="hidden"/><input name="sortOrder" value="@x.SortOrder" type="number" min="0" max="1000" class="form-control"/><button class="btn btn-sm btn-outline-secondary">Lưu thứ tự</button></form><form asp-action="Primary" method="post"><input name="carId" value="@Model.Id" type="hidden"/><input name="imageId" value="@x.Id" type="hidden"/><button class="btn btn-sm btn-outline-primary">Đặt ảnh chính</button></form><form asp-action="Delete" method="post"><input name="carId" value="@Model.Id" type="hidden"/><input name="imageId" value="@x.Id" type="hidden"/><button class="btn btn-sm btn-outline-danger">Xóa liên kết ảnh</button></form></div></div>}</div>
