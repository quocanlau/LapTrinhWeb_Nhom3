@model Autora.ViewModels.AdminNotificationPage
@{Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";ViewData["Title"]="Thông báo";}
<div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-4"><div><h3>Thông báo của bạn</h3><p class="text-secondary mb-0">30 ngày gần nhất · @Model.UnreadCount chưa đọc. Đánh dấu đã đọc không xử lý yêu cầu hay thay đổi giao dịch.</p></div>
<form asp-action="ReadAllPage" method="post"><button class="btn btn-dark" type="submit">Đánh dấu tất cả đã đọc</button></form></div>
<div class="d-flex gap-3 mb-3"><a asp-action="Index" class="btn btn-outline-secondary">Tất cả</a><a asp-action="Index" asp-route-unreadOnly="true" class="btn btn-outline-secondary">Chưa đọc</a></div>
@if(Model.Items.Count==0){<p class="alert alert-light border">Không có thông báo phù hợp.</p>}
@foreach(var item in Model.Items){<article class="notification-history-card @(item.IsRead?"":"is-unread")"><div class="d-flex justify-content-between gap-3 flex-wrap"><strong>@item.Title @if(!item.IsRead){<span class="badge bg-danger">Mới</span>}</strong><time datetime="@item.CreatedAt.ToString("O")">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></div><p>@item.Message</p><form asp-action="Open" method="post"><input type="hidden" name="key" value="@item.Key"/><button class="btn btn-sm btn-outline-dark">Mở nội dung</button></form></article>}
<nav aria-label="Phân trang thông báo" class="d-flex align-items-center gap-3 mt-4">@if(Model.Page>1){<a asp-action="Index" asp-route-page="@(Model.Page-1)" asp-route-unreadOnly="@Model.UnreadOnly">Trước</a>}<span>Trang @Model.Page / @Model.TotalPages</span>@if(Model.Page<Model.TotalPages){<a asp-action="Index" asp-route-page="@(Model.Page+1)" asp-route-unreadOnly="@Model.UnreadOnly">Sau</a>}</nav>
