@model Autora.ViewModels.PurchaseDraftForm
@{Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";var cars=(List<Car>)ViewBag.Cars;}
<h2>Phiếu nhập nháp</h2><p>Chọn xe chờ nhập, điền giá nguyên VND. Lưu nháp chưa đưa xe lên sàn.</p><form asp-action="Save" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"/><input asp-for="Version" type="hidden"/><select asp-for="SupplierId" class="form-select mb-3">@foreach(Supplier s in ViewBag.Suppliers){<option value="@s.Id">@s.Name</option>}</select>
<div id="purchaseLines">@for(int i=0;i<Model.Lines.Count;i++){<div class="row g-2 mb-2"><div class="col-md-7"><select name="Lines[@i].CarId" class="form-select">@foreach(var c in cars){<option value="@c.Id" selected="@(Model.Lines[i].CarId==c.Id)">@c.CarModel.Name · @c.VIN</option>}</select></div><div class="col-md-5"><input name="Lines[@i].PurchasePrice" type="number" min="1" step="1" value="@Model.Lines[i].PurchasePrice" class="form-control" required/></div></div>}</div>
<template id="purchaseLineTemplate"><div class="row g-2 mb-2"><div class="col-md-7"><select class="form-select" data-line="CarId">@foreach(var c in cars){<option value="@c.Id">@c.CarModel.Name · @c.VIN</option>}</select></div><div class="col-md-5"><input data-line="PurchasePrice" type="number" min="1" step="1" class="form-control" required placeholder="Giá nhập VND"/></div></div></template>
<button id="addPurchaseLine" type="button" class="btn btn-outline-secondary">Thêm dòng xe</button> <button class="btn btn-primary">Lưu nháp</button></form>
@section Scripts{<script src="~/js/purchase-draft.js" asp-append-version="true"></script>}
