@model Autora.ViewModels.PageResult<Customer>
@{Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";}
<h2>Khách hàng</h2><a asp-action="Edit" class="btn btn-primary mb-3">Thêm mới</a><form method="get" class="d-flex gap-2 mb-3"><input name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tìm kiếm"/><button class="btn btn-outline-secondary">Tìm</button></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Tên</th><th>Điện thoại</th><th>Thao tác</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.FullName</td><td>@x.Phone</td><td><a asp-action="Edit" asp-route-id="@x.Id">Sửa</a><form asp-action="Delete" method="post" class="d-inline"><input name="id" value="@x.Id" type="hidden"/><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>}</tbody></table></div>
<p>Trang @Model.Page / @Model.Pages · @Model.Total hồ sơ</p>@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-keyword="@Model.Keyword">Trang trước</a>} @if(Model.Page<Model.Pages){<a asp-route-page="@(Model.Page+1)" asp-route-keyword="@Model.Keyword">Trang sau</a>}
