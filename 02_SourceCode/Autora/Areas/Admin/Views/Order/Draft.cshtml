@model Autora.ViewModels.SaleDraftForm
@{Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";}
<h2>Giao dịch bán nháp</h2><p>Nháp chưa giữ xe. Chỉ khi xác nhận mới khóa xe cho giao dịch.</p><form asp-action="SaveDraft" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"/><input asp-for="Version" type="hidden"/><label>Khách hàng</label><select asp-for="CustomerId" class="form-select">@foreach(Customer c in ViewBag.Customers){<option value="@c.Id">@c.FullName · @c.Phone</option>}</select><label>Xe sẵn sàng</label><select asp-for="CarId" class="form-select">@foreach(Car c in ViewBag.Cars){<option value="@c.Id">@c.CarModel.Name · @c.VIN</option>}</select><label>Giá chốt VND</label><input asp-for="AgreedPrice" type="number" min="1" step="1" class="form-control"/><button class="btn btn-primary mt-3">Lưu nháp</button></form>
