@model List<Autora.Models.Manufacturer>
@using Autora.Models
@{Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";ViewData["Title"]="Hãng và dòng xe";}
<h3>Hãng xe</h3><form asp-action="Save" method="post" class="d-flex gap-2 mb-3 flex-wrap"><input name="Name" placeholder="Tên hãng" maxlength="100" required class="form-control w-auto"/><input name="Country" placeholder="Quốc gia" maxlength="100" class="form-control w-auto"/><input name="IsActive" value="true" type="hidden"/><button class="btn btn-primary">Thêm hãng</button></form>
@foreach(var m in Model){<div class="card p-3 mb-2"><form asp-action="Save" method="post" class="d-flex gap-2 flex-wrap"><input name="Id" value="@m.Id" type="hidden"/><input name="Name" value="@m.Name" required maxlength="100" class="form-control w-auto"/><input name="Country" value="@m.Country" maxlength="100" class="form-control w-auto"/><label><input name="IsActive" type="checkbox" value="true" checked="@m.IsActive"/> Đang sử dụng</label><input name="IsActive" type="hidden" value="false"/><button class="btn btn-primary">Lưu</button></form><form asp-action="Delete" method="post" class="mt-2"><input name="id" value="@m.Id" type="hidden"/><button class="btn btn-outline-danger">Xóa hãng chưa có dòng</button></form></div>}
<h3 class="mt-4">Dòng xe</h3><form asp-action="AddModel" method="post" class="d-flex gap-2 mb-3 flex-wrap"><select name="ManufacturerId" class="form-select w-auto">@foreach(var m in Model.Where(x=>x.IsActive)){<option value="@m.Id">@m.Name</option>}</select><input name="Name" required maxlength="100" placeholder="Tên dòng" class="form-control w-auto"/><input name="BodyType" required maxlength="30" placeholder="SUV/Sedan..." class="form-control w-auto"/><button class="btn btn-primary">Thêm dòng</button></form>
@foreach(CarModel m in ViewBag.Models){<p>@m.Manufacturer.Name · @m.Name · @m.BodyType</p>}

@foreach(CarModel m in ViewBag.Models){<div class="d-flex gap-2 mb-2"><a asp-action="EditModel" asp-route-id="@m.Id">Sửa @m.Manufacturer.Name @m.Name</a><form asp-action="DeleteModel" method="post"><input name="id" value="@m.Id" type="hidden"/><button class="btn btn-sm btn-outline-danger">Xóa dòng chưa có xe</button></form></div>}