@model Autora.ViewModels.PasswordForm
@{bool en=CarTranslationHelper.IsEnglish;}
<div class="container py-4" style="max-width:640px"><h2>@(en?"Change password":"Đổi mật khẩu")</h2><form asp-action="ChangePassword" method="post"><div asp-validation-summary="All" class="text-danger"></div>
<label>@(en?"Current password":"Mật khẩu hiện tại")</label><input asp-for="CurrentPassword" class="form-control mb-3"/>
<label>@(en?"New password":"Mật khẩu mới")</label><input asp-for="NewPassword" class="form-control mb-3"/>
<label>@(en?"Confirm password":"Xác nhận mật khẩu")</label><input asp-for="ConfirmPassword" class="form-control mb-3"/>
<button class="btn btn-primary">@(en?"Save":"Đổi mật khẩu")</button></form></div>
