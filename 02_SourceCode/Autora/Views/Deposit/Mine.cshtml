@model Autora.ViewModels.CustomerOrders
@using Autora.Services
@{
    ViewData["Title"] = L["Mine_Title"];
}

<div class="container py-4">
    <h3 class="fw-bold text-white mb-3">@L["Mine_Title"]</h3>
    @if(TempData["Message"] is string msg)
    {
        <div class="alert alert-success rounded-4 border-0 shadow-sm mb-4">@msg</div>
    }

    <h4 class="text-white mt-4 mb-3">@L["Mine_RequestsHeading"]</h4>
    @if (!Model.Requests.Any())
    {
        <p class="text-secondary small">@(CarTranslationHelper.IsEnglish ? "No deposit requests recorded yet." : "Chưa có yêu cầu đặt cọc nào.")</p>
    }
    @foreach(var r in Model.Requests)
    {
        <div class="p-3 mb-2 rounded-3 border border-secondary border-opacity-25" style="background-color: #FFFFFF;">
            <div class="d-flex justify-content-between align-items-center">
                <strong>#@r.Id · @r.Car.CarModel.Name</strong>
                <span class="badge bg-secondary">@CarTranslationHelper.TranslateStatus(r.Car.Status)</span>
            </div>
            <div class="text-secondary small mt-1">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
        </div>
    }

    <h4 class="text-white mt-4 mb-3">@L["Mine_SalesHeading"]</h4>
    @if (!Model.Sales.Any())
    {
        <p class="text-secondary small">@(CarTranslationHelper.IsEnglish ? "No confirmed sales transactions yet." : "Chưa có giao dịch mua bán nào.")</p>
    }
    @foreach(var s in Model.Sales)
    {
        <div class="p-3 mb-3 rounded-4 border border-secondary border-opacity-25" style="background-color: #FFFFFF;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="m-0 text-white fw-bold">#@s.Id · @s.Car.CarModel.Name</h5>
                <span class="badge bg-lime text-dark fw-bold">@CarTranslationHelper.TranslateStatus(s.Car.Status)</span>
            </div>
            <p class="text-secondary small mb-1">
                @L["Mine_AgreedPrice"] <strong class="text-white">@s.AgreedPrice.ToString("N0") đ</strong> · 
                @L["Mine_Deposit"] <strong class="text-lime">@s.RequiredDeposit.ToString("N0") đ</strong>
            </p>
            <p class="text-secondary small m-0">
                @L["Mine_Paid"] <strong class="text-white">@DepositPolicy.NetPaid(s).ToString("N0") đ</strong> · 
                @L["Mine_Remaining"] <strong class="text-warning">@((s.AgreedPrice-DepositPolicy.NetPaid(s)).ToString("N0")) đ</strong>
            </p>
        </div>
    }
</div>
