@model List<Car>
@{ViewData["Title"]="So sánh xe"; bool en=CarTranslationHelper.IsEnglish;}
<div class="container py-4"><h2>@(en?"Compare up to 3 cars":"So sánh tối đa 3 xe")</h2><p>@TempData["Message"]</p>
<a asp-controller="Car" asp-action="Index">@(en?"Choose more cars":"Chọn thêm xe")</a>
@if(Model.Count==0){<p class="mt-3">@(en?"No cars selected.":"Chưa chọn xe để so sánh.")</p>}
else{<div class="table-responsive mt-3"><table class="table"><thead><tr><th>@(en?"Specification":"Thông số")</th>@foreach(var c in Model){<th>@c.CarModel.Manufacturer.Name @c.CarModel.Name<form asp-action="Remove" method="post"><input type="hidden" name="carId" value="@c.Id"/><button class="btn btn-sm btn-outline-danger">@(en?"Remove":"Bỏ chọn")</button></form></th>}</tr></thead><tbody>
<tr><th>@(en?"Price":"Giá")</th>@foreach(var c in Model){<td>@c.ListedPrice.ToString("N0") đ</td>}</tr>
<tr><th>@(en?"Year":"Năm")</th>@foreach(var c in Model){<td>@c.ManufactureYear</td>}</tr>
<tr><th>Km</th>@foreach(var c in Model){<td>@c.Mileage.ToString("N0")</td>}</tr>
<tr><th>@(en?"Fuel":"Nhiên liệu")</th>@foreach(var c in Model){<td>@CarTranslationHelper.TranslateFuel(c.Fuel)</td>}</tr>
<tr><th>@(en?"Transmission":"Hộp số")</th>@foreach(var c in Model){<td>@CarTranslationHelper.TranslateTransmission(c.Transmission)</td>}</tr>
<tr><th>@(en?"Condition":"Tình trạng")</th>@foreach(var c in Model){<td>@CarTranslationHelper.TranslateCondition(c.Condition)</td>}</tr>
<tr><th>@(en?"Status":"Trạng thái")</th>@foreach(var c in Model){<td>@CarTranslationHelper.TranslateStatus(c.Status)</td>}</tr>
<tr><th>@(en?"Details":"Chi tiết")</th>@foreach(var c in Model){<td><a asp-controller="Car" asp-action="Details" asp-route-id="@c.Id">@(en?"View":"Xem xe")</a></td>}</tr>
</tbody></table></div>}</div>
