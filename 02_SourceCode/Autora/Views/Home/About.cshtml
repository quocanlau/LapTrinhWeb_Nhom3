@{
    ViewData["Title"] = L["About_Title"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- 1. HERO HEADER: GIỚI THIỆU CHUNG -->
<section class="position-relative overflow-hidden py-5" style="background: radial-gradient(circle at 60% 30%, #DCE7EA 0%, #F6F7F8 75%);">
    <div class="container py-4">
        <div class="row align-items-center gy-5">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 mb-3">
                    <span style="height:2px; width:28px; background-color: var(--accent-lime); display:inline-block;"></span>
                    <span style="color: var(--accent-lime); font-size: 0.75rem; letter-spacing: 0.15em; font-weight:800;">@L["About_HeroEyebrow"]</span>
                </div>
                <h1 class="display-4 fw-bolder text-white lh-sm mb-3">
                    @Html.Raw(L["About_HeroH1"])
                </h1>
                <p class="text-secondary lead fs-6 pe-lg-5 mb-4">
                    @L["About_HeroDesc"]
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Car" asp-action="Index" class="btn-lime">
                        @L["About_ExploreBtn"] <i class="bi bi-arrow-right"></i>
                    </a>
                    <a href="#contact-section" class="btn-outline-custom">
                        <i class="bi bi-geo-alt"></i> @L["About_ShowroomsBtn"]
                    </a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="position-relative rounded-4 overflow-hidden border border-secondary border-opacity-25 shadow-lg">
                    <img src="https://images.unsplash.com/photo-1563720223185-11003d516935?q=80&w=1000&auto=format&fit=crop" 
                         alt="AUTORA Showroom" class="img-fluid w-100 object-fit-cover" style="height: 380px;" />
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 photo-caption">
                        <span class="text-white fw-bold d-block">@L["About_FlagshipHanoi"]</span>
                        <span class="small" style="color: var(--accent-lime);">@L["About_FlagshipDesc"]</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. SỐ LIỆU ẤN TƯỢNG (STATS COUNTER) -->
<section class="py-4 border-top border-bottom border-secondary border-opacity-25" style="background-color: #EEF2F3;">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <h2 class="display-5 fw-bold text-white mb-0">200+</h2>
                <span class="text-secondary small">@L["About_StatCars"]</span>
            </div>
            <div class="col-6 col-md-3 border-start border-secondary border-opacity-25">
                <h2 class="display-5 fw-bold" style="color: var(--accent-lime);">15+</h2>
                <span class="text-secondary small">@L["About_StatBrands"]</span>
            </div>
            <div class="col-6 col-md-3 border-start-md border-secondary border-opacity-25">
                <h2 class="display-5 fw-bold text-white mb-0">10.000+</h2>
                <span class="text-secondary small">@L["About_StatClients"]</span>
            </div>
            <div class="col-6 col-md-3 border-start border-secondary border-opacity-25">
                <h2 class="display-5 fw-bold" style="color: var(--accent-lime);">120</h2>
                <span class="text-secondary small">@L["About_StatChecks"]</span>
            </div>
        </div>
    </div>
</section>

<!-- 3. TẦM NHÌN & SỨ MỆNH -->
<section class="py-5">
    <div class="container py-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="text-secondary small fw-bold text-uppercase">@L["About_CoreValues"]</span>
            <h2 class="text-white fw-bold mt-1">@L["About_WhyChoose"]</h2>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="p-4 rounded-4 h-100" style="background-color: #FFFFFF; border: 1px solid #DCE1E4;">
                    <div class="brand-icon-box mb-3" style="width: 44px; height: 44px; font-size: 1.25rem;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5 class="text-white fw-bold mb-2">@L["About_Value1Title"]</h5>
                    <p class="text-secondary small m-0">
                        @L["About_Value1Desc"]
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 h-100" style="background-color: #FFFFFF; border: 1px solid #DCE1E4;">
                    <div class="brand-icon-box mb-3" style="width: 44px; height: 44px; font-size: 1.25rem;">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <h5 class="text-white fw-bold mb-2">@L["About_Value2Title"]</h5>
                    <p class="text-secondary small m-0">
                        @L["About_Value2Desc"]
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 h-100" style="background-color: #FFFFFF; border: 1px solid #DCE1E4;">
                    <div class="brand-icon-box mb-3" style="width: 44px; height: 44px; font-size: 1.25rem;">
                        <i class="bi bi-award"></i>
                    </div>
                    <h5 class="text-white fw-bold mb-2">@L["About_Value3Title"]</h5>
                    <p class="text-secondary small m-0">
                        @L["About_Value3Desc"]
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 4. DỊCH VỤ CỐT LÕI -->
<section class="py-5" style="background-color: #EEF2F3;">
    <div class="container py-4">
        <div class="row align-items-center gy-4 mb-4">
            <div class="col-md-8">
                <span class="text-secondary small fw-bold text-uppercase">@L["About_ServicesEyebrow"]</span>
                <h2 class="text-white fw-bold mt-1">@L["About_ServicesTitle"]</h2>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="p-4 rounded-4 border border-secondary border-opacity-25 bg-dark h-100">
                    <i class="bi bi-arrow-repeat fs-2 mb-3 d-block" style="color: var(--accent-lime);"></i>
                    <h6 class="text-white fw-bold mb-2">@L["About_Svc1Title"]</h6>
                    <p class="text-secondary small m-0">@L["About_Svc1Desc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-4 rounded-4 border border-secondary border-opacity-25 bg-dark h-100">
                    <i class="bi bi-percent fs-2 mb-3 d-block" style="color: var(--accent-lime);"></i>
                    <h6 class="text-white fw-bold mb-2">@L["About_Svc2Title"]</h6>
                    <p class="text-secondary small m-0">@L["About_Svc2Desc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-4 rounded-4 border border-secondary border-opacity-25 bg-dark h-100">
                    <i class="bi bi-car-front fs-2 mb-3 d-block" style="color: var(--accent-lime);"></i>
                    <h6 class="text-white fw-bold mb-2">@L["About_Svc3Title"]</h6>
                    <p class="text-secondary small m-0">@L["About_Svc3Desc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-4 rounded-4 border border-secondary border-opacity-25 bg-dark h-100">
                    <i class="bi bi-file-earmark-check fs-2 mb-3 d-block" style="color: var(--accent-lime);"></i>
                    <h6 class="text-white fw-bold mb-2">@L["About_Svc4Title"]</h6>
                    <p class="text-secondary small m-0">@L["About_Svc4Desc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 5. HỆ THỐNG SHOWROOM & FORM LIÊN HỆ -->
<section class="py-5" id="contact-section">
    <div class="container py-4">
        <div class="row g-5">
            <!-- Địa chỉ các showroom -->
            <div class="col-lg-6">
                <span class="text-secondary small fw-bold text-uppercase">@L["About_NetworkEyebrow"]</span>
                <h3 class="text-white fw-bold mt-1 mb-4">@L["About_VisitTitle"]</h3>

                <div class="d-flex flex-column gap-3">
                    <div class="p-3 rounded-4" style="background-color: #FFFFFF; border: 1px solid #DCE1E4;">
                        <h6 class="text-white fw-bold mb-1"><i class="bi bi-geo-alt-fill me-2" style="color: var(--accent-lime);"></i>@L["About_ShowroomHanoi"]</h6>
                        <p class="text-secondary small mb-1">@L["About_ShowroomHanoiAddr"]</p>
                        <span class="small text-white-50"><i class="bi bi-telephone me-1"></i>Hotline: 0987.654.321 @L["About_HotlineHours"]</span>
                    </div>

                    <div class="p-3 rounded-4" style="background-color: #FFFFFF; border: 1px solid #DCE1E4;">
                        <h6 class="text-white fw-bold mb-1"><i class="bi bi-geo-alt-fill me-2" style="color: var(--accent-lime);"></i>@L["About_ShowroomHcm"]</h6>
                        <p class="text-secondary small mb-1">@L["About_ShowroomHcmAddr"]</p>
                        <span class="small text-white-50"><i class="bi bi-telephone me-1"></i>Hotline: 0912.333.444 @L["About_HotlineHours"]</span>
                    </div>
                </div>
            </div>

            <!-- Form đăng ký nhận tư vấn -->
            <div class="col-lg-6">
                <div class="p-4 p-md-5 rounded-4" style="background-color: #FFFFFF; border: 1px solid #DCE1E4;">
                    <h4 class="text-white fw-bold mb-2">@L["About_ConsultHeading"]</h4>
                    <p class="text-secondary small mb-4">@L["About_ConsultDesc"]</p>

                    <form id="contactForm" onsubmit="event.preventDefault(); alert('@(CarTranslationHelper.IsEnglish ? "Thank you! Our advisory team will contact you shortly." : "Cảm ơn quý khách! Đội ngũ tư vấn sẽ liên hệ lại trong ít phút.")'); this.reset();">
                        <div class="mb-3">
                            <label class="text-secondary small mb-1">@L["About_FullName"]</label>
                            <input type="text" class="form-control bg-dark border-secondary text-white rounded-3 px-3 py-2" placeholder="Nguyễn Văn A" required />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="text-secondary small mb-1">@L["About_Phone"]</label>
                                <input type="tel" class="form-control bg-dark border-secondary text-white rounded-3 px-3 py-2" placeholder="0987xxxxxx" required />
                            </div>
                            <div class="col-6">
                                <label class="text-secondary small mb-1">@L["About_InterestedModel"]</label>
                                <select class="form-select bg-dark border-secondary text-white rounded-3 px-3 py-2">
                                    <option>Mercedes-Benz</option>
                                    <option>BMW</option>
                                    <option>Toyota</option>
                                    <option>Porsche</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="text-secondary small mb-1">@L["About_SpecificNeed"]</label>
                            <textarea class="form-control bg-dark border-secondary text-white rounded-3 px-3 py-2" rows="3" placeholder="@L["About_NeedPlaceholder"]"></textarea>
                        </div>
                        <button type="submit" class="btn btn-lime w-100 py-3 fw-bold text-dark rounded-pill">
                            @L["About_SubmitBtn"]
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>