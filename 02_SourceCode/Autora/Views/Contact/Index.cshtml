@model ContactInquiry
@{bool en=CarTranslationHelper.IsEnglish;}
<div class="container py-4" style="max-width:640px"><h2>@(en?"Request a quote":"Yêu cầu tư vấn / báo giá")</h2><form asp-action="Save" method="post"><div asp-validation-summary="All" class="text-danger"></div><label>@(en?"Full name":"Họ tên")</label><input asp-for="FullName" class="form-control mb-2"/><label>Email</label><input asp-for="Email" class="form-control mb-2"/><label>@(en?"Phone":"Điện thoại")</label><input asp-for="Phone" class="form-control mb-2"/><label>@(en?"Interested model":"Mẫu xe quan tâm")</label><input asp-for="InterestedModel" class="form-control mb-2"/><label>@(en?"Message":"Nhu cầu")</label><textarea asp-for="Message" class="form-control mb-2"></textarea><button class="btn btn-primary">@(en?"Submit":"Gửi yêu cầu")</button></form></div>
