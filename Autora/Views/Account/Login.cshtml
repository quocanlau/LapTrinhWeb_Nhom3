@model Autora.ViewModels.LoginForm
@{
    ViewData["Title"] = L["Account_LoginTitle"];
}

                                                                 
<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 82vh;">
                                                
    <div class="p-4 p-sm-5 rounded-4 border border-secondary border-opacity-25 shadow-lg" 
         style="width: 100%; max-width: 440px; background-color: #FFFFFF;">
        
                               
        <div class="text-center mb-4">
            <div class="brand-icon-box mx-auto mb-3" style="width: 44px; height: 44px; font-size: 1.25rem;">
                <i class="bi bi-car-front-fill"></i>
            </div>
            <h4 class="fw-bolder text-white mb-1">AUTORA MOTORS</h4>
            <p class="text-secondary small">@L["Account_PortalSubtitle"]</p>
        </div>

                               
        <form asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />

                                                
            <div asp-validation-summary="ModelOnly" 
                 class="alert alert-danger py-2 px-3 small border-0 mb-3" 
                 style="background-color: rgba(220, 53, 69, 0.15); color: #B42318;"></div>

                                 
            <div class="mb-3">
                <label asp-for="Email" class="form-label text-secondary small fw-bold text-uppercase mb-1">
                    @L["Account_Email"]
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary border-opacity-50 text-secondary border-end-0 rounded-start-3">
                        <i class="bi bi-envelope"></i>
                    </span>
                    <input asp-for="Email" 
                           class="form-control bg-dark border-secondary border-opacity-50 text-white border-start-0 rounded-end-3 py-2 px-3" 
                           placeholder="name@example.com" 
                           autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

                                    
            <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <label asp-for="Password" class="form-label text-secondary small fw-bold text-uppercase m-0">
                        @L["Account_Password"]
                    </label>
                </div>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary border-opacity-50 text-secondary border-end-0 rounded-start-3">
                        <i class="bi bi-shield-lock"></i>
                    </span>
                    <input asp-for="Password" 
                           type="password" 
                           class="form-control bg-dark border-secondary border-opacity-50 text-white border-start-0 rounded-end-3 py-2 px-3" 
                           placeholder="••••••••" 
                           autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

                                               
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input bg-dark border-secondary cursor-pointer" id="rememberMeCheck" />
                <label asp-for="RememberMe" class="form-check-label text-secondary small cursor-pointer" for="rememberMeCheck">
                    @L["Account_RememberMe"]
                </label>
            </div>

                                  
            <button type="submit" class="btn btn-lime w-100 py-3 rounded-pill fw-bold text-dark fs-6 shadow-sm d-flex align-items-center justify-content-center gap-2 mb-3">
                <span>@L["Account_LoginBtn"]</span>
                <i class="bi bi-arrow-right"></i>
            </button>
        </form>

                                               
        <div class="text-center pt-3 border-top border-secondary border-opacity-25">
            <span class="text-secondary small">@L["Account_NoAccount"] </span>
            <a asp-action="Register" class="text-lime fw-bold small text-decoration-none hover-underline">
                @L["Account_CreateAccount"] <i class="bi bi-chevron-right small"></i>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}