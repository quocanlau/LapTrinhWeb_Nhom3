@model ShowroomSetting
@{Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";}
<h2>Cài đặt showroom</h2><p>@TempData["Message"]</p><form asp-action="SaveShowroom" method="post"><div asp-validation-summary="All" class="text-danger"></div><input name="version" value="@(ViewBag.Version ?? (Model.RowVersion.Length==0?"":Convert.ToBase64String(Model.RowVersion)))" type="hidden"/>
<label>Tên showroom</label><input asp-for="Name" class="form-control mb-2"/><label>Hotline</label><input asp-for="Hotline" class="form-control mb-2"/><label>Email</label><input asp-for="Email" class="form-control mb-2"/><label>Địa chỉ</label><input asp-for="Address" class="form-control mb-2"/><label>Giờ mở cửa</label><input asp-for="OpeningHours" class="form-control mb-2"/><label>Chính sách công bố</label><textarea asp-for="Policy" class="form-control mb-2"></textarea><p>Cọc bắt buộc 2% giá bán chốt. Chưa tích hợp thanh toán ngân hàng trực tuyến.</p><button class="btn btn-primary">Lưu cấu hình</button></form>
