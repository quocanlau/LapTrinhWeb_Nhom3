@model Autora.ViewModels.PurchaseDraftForm
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var cars = (List<Car>?)ViewBag.Cars ?? [];
    var suppliers = (List<Supplier>?)ViewBag.Suppliers ?? [];
}

<h2>Phiếu nhập nháp</h2>
<p>Chọn xe chờ nhập, điền giá nguyên VND. Lưu nháp chưa đưa xe lên sàn.</p>

<form asp-action="Save" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input asp-for="Id" type="hidden" />
    <input asp-for="Version" type="hidden" />

    <select asp-for="SupplierId" class="form-select mb-3">
        <option value="">-- Chọn đối tác --</option>
        @foreach (var supplier in suppliers)
        {
            <option value="@supplier.Id">@supplier.Name</option>
        }
    </select>

    @if (cars.Count == 0 && Model.Lines.Count == 0)
    {
        <div class="alert alert-warning">
            Hiện không có xe đang chờ nhập. Hãy tạo xe mới tại mục <strong>Quản lý kho xe</strong>,
            sau đó quay lại trang này để lập phiếu nhập.
        </div>
    }

    <div id="purchaseLines">
        @for (var i = 0; i < Model.Lines.Count; i++)
        {
            <div class="row g-2 mb-2 purchase-line">
                <div class="col-md-7">
                    <select name="Lines[@i].CarId" class="form-select" required>
                        <option value="">-- Chọn xe --</option>
                        @foreach (var car in cars)
                        {
                            <option value="@car.Id" selected="@(Model.Lines[i].CarId == car.Id ? "selected" : null)">
                                @car.CarModel.Name · @car.VIN
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <input name="Lines[@i].PurchasePrice" type="number" min="1" step="1"
                           value="@Model.Lines[i].PurchasePrice" class="form-control" required
                           placeholder="Giá nhập VND" />
                </div>
            </div>
        }
    </div>

    <template id="purchaseLineTemplate">
        <div class="row g-2 mb-2 purchase-line">
            <div class="col-md-7">
                <select class="form-select" data-line="CarId" required>
                    <option value="">-- Chọn xe --</option>
                    @foreach (var car in cars)
                    {
                        <option value="@car.Id">@car.CarModel.Name · @car.VIN</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <input data-line="PurchasePrice" type="number" min="1" step="1"
                       class="form-control" required placeholder="Giá nhập VND" />
            </div>
        </div>
    </template>

    <button id="addPurchaseLine" type="button" class="btn btn-outline-secondary" @(cars.Count == 0 ? "disabled" : null)>Thêm dòng xe</button>
    <button type="submit" class="btn btn-primary" @(cars.Count == 0 && Model.Lines.Count == 0 ? "disabled" : null)>Lưu nháp</button>
</form>
@section Scripts{<script src="~/js/purchase-draft.js" asp-append-version="true"></script>}
