@model Autora.ViewModels.ModelForm
@{Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";}
<h2>Sửa dòng xe</h2><form asp-action="SaveModel" method="post"><input asp-for="Id" type="hidden"/><label>Hãng</label><select asp-for="ManufacturerId" class="form-select">@foreach(Manufacturer m in ViewBag.Manufacturers){<option value="@m.Id">@m.Name</option>}</select><label>Tên dòng</label><input asp-for="Name" class="form-control"/><label>Kiểu dáng</label><input asp-for="BodyType" class="form-control"/><label><input asp-for="IsActive"/> Đang sử dụng</label><button class="btn btn-primary">Lưu</button></form>
