@model Autora.ViewModels.PageResult<ContactInquiry>
@{Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";}
<h2>Yêu cầu tư vấn / báo giá</h2>@foreach(var c in Model.Items){<div class="card p-3 mb-3"><strong>@c.FullName</strong><p>@c.Phone · @c.Email · @c.InterestedModel</p><p>@c.Message</p><time>@c.CreatedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</time></div>}<p>Trang @Model.Page / @Model.Pages</p>@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)">Trước</a>} @if(Model.Page<Model.Pages){<a asp-route-page="@(Model.Page+1)">Sau</a>}
