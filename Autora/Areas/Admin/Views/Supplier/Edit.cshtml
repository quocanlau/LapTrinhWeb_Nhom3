@model Autora.ViewModels.SupplierForm
@{Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";}
<h2>Hồ sơ đối tác</h2><form asp-action="Save" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"/><label class="d-block mt-2">Tên đối tác</label><input asp-for="Name" class="form-control"/><label class="d-block mt-2">Cá nhân hoặc Tổ chức</label><input asp-for="SupplierType" class="form-control"/><label class="d-block mt-2">Điện thoại</label><input asp-for="Phone" class="form-control"/><label class="d-block mt-2">Địa chỉ</label><input asp-for="Address" class="form-control"/><label class="d-block mt-2">Đang sử dụng</label><input asp-for="IsActive" class="form-check-input"/><button class="btn btn-primary mt-3">Lưu</button></form>
